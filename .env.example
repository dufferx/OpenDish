# --- Client (apps/web) -------------------------------------------------------
# Copy this file to apps/web/.env.local for a managed installation, or let
# `pnpm setup:local` generate the localhost profile automatically.
# URL of your Supabase project (local: derived from `pnpm supabase status`)
VITE_SUPABASE_URL=
# Public publishable key (`sb_publishable_...`; local: derived from
# `pnpm supabase status`)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Do not place an OpenAI API key in this client environment file. OpenDish is
# BYOK per account: sign in, open Settings, and save the key there so the
# ai-configure Edge Function can validate it and store it server-side in Vault.
# `OPENAI_API_KEY` in `supabase/config.toml` belongs only to local Supabase
# Studio's own AI assistant; it is not an OpenDish provider credential.

# Configure Google OAuth only if you want that provider. For hosted projects,
# configure it in Authentication > Sign In / Providers. For the local stack,
# keep these values out of `apps/web/.env.local`, export them in your shell,
# enable `[auth.external.google]` in `supabase/config.toml`, and then run
# `pnpm setup:local`. Never expose the secret as a `VITE_` variable.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Phase 11.75 social-video import does NOT use client-side secrets. Do not add
# `VIDEO_IMPORT_SERVICE_URL` or `VIDEO_IMPORT_SERVICE_SECRET` to this file:
# those belong in Supabase Edge Function secrets and the separately hosted
# `services/video-import` service environment only.
