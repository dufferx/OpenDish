# --- Client (apps/web) -------------------------------------------------------
# Copy this file to apps/web/.env.local for a managed installation, or let
# `pnpm setup:local` generate the localhost profile automatically.
# URL of your Supabase project (local: derived from `pnpm supabase status`)
VITE_SUPABASE_URL=
# Public publishable key (`sb_publishable_...`; local: derived from
# `pnpm supabase status`)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Configure Google OAuth only if you want that provider. For hosted projects,
# configure it in Authentication > Sign In / Providers. For the local stack,
# keep these values out of `apps/web/.env.local`, export them in your shell,
# enable `[auth.external.google]` in `supabase/config.toml`, and then run
# `pnpm setup:local`. Never expose the secret as a `VITE_` variable.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
