# --- Client (apps/web) -------------------------------------------------------
# Copy this file to apps/web/.env.local and fill in real values.
# URL of your Supabase project (local: http://127.0.0.1:54321)
VITE_SUPABASE_URL=
# Public anon key (local: printed by `pnpm supabase start`)
VITE_SUPABASE_ANON_KEY=
# Single-owner gate: only this Google account email may sign in.
# Enforced server-side via a Supabase Auth hook (see T018); also read by the
# client only for UX messaging.
ALLOWED_EMAIL=

# --- Edge Function secrets ---------------------------------------------------
# These are NOT placed in any .env file. Set them with:
#   pnpm supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=...
# (locally: create supabase/functions/.env instead — it is gitignored)
# GOOGLE_CLIENT_ID=        # Google OAuth client ID for Supabase Auth
# GOOGLE_CLIENT_SECRET=    # Google OAuth client secret for Supabase Auth
